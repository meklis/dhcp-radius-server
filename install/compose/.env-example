# Версия образа ghcr.io/meklis/dhcp-radius-server (тег релиза, например 0.3.3, или latest)
IMAGE_TAG=latest

# Radius secret
RADIUS_SECRET=secret

#Интерфейс и порт, который слушает радиус
RADIUS_LISTEN_ADDR=0.0.0.0:1812

# Адрес API (processor: api)
API_ADDR=http://radius-api:8080/v1

# Адрес базы устройств/привязок (processor: script, обязателен для него)
CLIENTDB_URL=https://example.com/radius/database

# Опционально (processor: script): redis для точечных обновлений/удалений binds по id,
# в дополнение к полному reload по CLIENTDB_URL выше. Если не задан - не используется.
CLIENTDB_REDIS_ADDR=redis:6379

# Интервал полного reload базы устройств/привязок по CLIENTDB_URL
CLIENTDB_REFRESH_INTERVAL=5m

# Таймаут HTTP-запроса к CLIENTDB_URL (binds отдаёт сотни тысяч строк - таймаут на весь
# запрос, включая чтение тела)
CLIENTDB_TIMEOUT=90s

# Уровень логирования: 4 - production, 6 - debug
LOG_LEVEL=4

# Размер SO_RCVBUF в байтах для radius-сокета. 0 - системный default (обычно маловат
# под нагрузкой)
RADIUS_READ_BUFFER_SIZE=8388608

# Размер пула Lua-воркеров (processor: script). Проверено нагрузочным тестированием -
# дальнейшее увеличение (до 500) не даёт прироста производительности, см. doc/LOAD_TESTING.md
SCRIPT_POOL_SIZE=300

# Таймаут выполнения одного Lua-скрипта (processor: script)
SCRIPT_TIMEOUT=3s
